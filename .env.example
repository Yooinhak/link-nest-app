# Link Nest 환경 변수 예시
#
# 사용법:
#   1) 이 파일을 복사: `cp .env.example .env`
#   2) 아래 값을 Supabase 프로젝트 대시보드에서 가져와 채워 넣으세요.
#   3) .env는 절대 git에 커밋하지 않습니다(.gitignore로 관리).
#   4) CI/CD 빌드(EAS Build)에서는 `eas secret:create`로 주입하세요.

# --- API ---
# 로컬 개발용 API 서버 주소 (사용하지 않는 경우 비워두거나 제거)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Supabase ---
# Project Settings → API 에서 확인
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon(public) 키 — RLS 전제 하에 클라이언트에 노출되지만,
# 그래도 git 커밋 금지. 새 프로젝트/키 교체 시 반드시 본 파일에는 값 비우기.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Auth Storage 토큰 키 이름 (기본 포맷: sb-<project-ref>-auth-token)
EXPO_PUBLIC_SUPABASE_TOKEN=sb-your-project-ref-auth-token
