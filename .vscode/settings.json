{
  "// 설명": "supabase/functions 는 Deno 런타임에서 실행되므로 해당 폴더에서만 Deno 확장을 활성화한다. 나머지(React Native/Expo)는 기본 TS 서버를 사용.",
  "deno.enable": false,
  "deno.enablePaths": ["./supabase/functions"],
  "deno.lint": true,
  "deno.unstable": false,
  "deno.importMap": "./supabase/functions/deno.json",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript][deno]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}
