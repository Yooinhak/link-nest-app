{
  "expo": {
    "name": "Link Nest",
    "slug": "link-nest-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "link-nest-app",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3182F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.inak.linknest",
      "appleTeamId": "ARPM23GNDZ",
      "_usesAppleSignIn_TODO": "Apple Developer 멤버십 가입 후 true로 복원",
      "usesAppleSignIn": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3182F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "dev.inak.linknest",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "link-nest",
          "project": "link-nest-app"
        }
      ]
    ],
    "_disabled_plugins_TODO": {
      "_comment": "Apple Developer 멤버십 가입 후 plugins 배열에 복원",
      "expo-apple-authentication": "Apple Sign In entitlement 필요",
      "expo-share-intent": "App Groups entitlement + Share Extension 프로비저닝 필요"
    }
  }
}
